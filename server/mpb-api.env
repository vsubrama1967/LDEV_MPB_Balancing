# mpb-api environment — copy to /etc/mpb-api.env and lock it down:
#   sudo cp mpb-api.env /etc/mpb-api.env
#   sudo chown root:root /etc/mpb-api.env
#   sudo chmod 600 /etc/mpb-api.env        # only root can read the secret

CLIENT_ID=mpbbalance
CLIENT_SECRET=nJJ5lPX4XSVCrvAO40e1LSzqFIsKiZ7F
PORT=3001
BIND=127.0.0.1

# Per-host OAuth credentials do NOT go here — systemd's EnvironmentFile mangles
# inline JSON quotes. They live in a separate JSON file that server.js reads
# directly. Default path /etc/mpb-api.creds.json (override with CREDENTIALS_FILE).
# CREDENTIALS_FILE=/etc/mpb-api.creds.json
#
# CLIENT_SECRET above is the FALLBACK used for any host not listed in that file.

# The VSP360 host (IP or hostname) is now entered in the UI's Data Source screen
# and sent per request, so it is NOT configured here. The line below is only an
# optional fallback default used when the UI doesn't supply one (e.g. a raw curl).
# VSP_HOST=192.168.53.61
# AUTH_REALM=vsp360

# Default storage-system name filter (regex). The UI "Storage system" field
# overrides this per request via ?storage=. Time range comes from the UI dropdown
# (?start/&end); server.js defaults to the last 24h if absent.
STORAGE=DC1-B28-B
